APP_NAME=cv-builder-backend
APP_ENV=development
APP_VERSION=0.1.0
PORT=4000
LOG_LEVEL=info
FRONTEND_APP_URL=http://localhost:5173
# Comma-separated extra origins allowed by CORS (e.g. Vercel preview URL).
# Production frontend URL set via FRONTEND_APP_URL is always allowed.
CORS_ALLOWED_ORIGINS=

# AI provider: mock | gemini | openai | anthropic
AI_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-3-flash-preview
AI_PROMPT_PROFILE=phase3-v1
GEMINI_API_KEY=
AI_GEMINI_MODEL_LIGHT=gemini-3-flash
AI_GEMINI_MODEL_HEAVY=gemini-2.5-flash
AI_GEMINI_MAX_ATTEMPTS=1
AI_GEMINI_RETRY_BASE_DELAY_MS=1000
AI_GEMINI_RETRY_MAX_DELAY_MS=16000

# OpenAI provider (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
AI_OPENAI_MODEL_LIGHT=gpt-5.6-luna
AI_OPENAI_MODEL_HEAVY=gpt-5.6-terra
# none | minimal | low | medium | high — GPT-5.x reasoning tokens count against
# the output cap, so keep this low for structured extraction flows.
AI_OPENAI_REASONING_EFFORT=low

# Anthropic provider (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5
AI_ANTHROPIC_MODEL_HEAVY=claude-sonnet-5

# Shared knobs for the OpenAI/Anthropic providers (Gemini keeps AI_GEMINI_*)
AI_REQUEST_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=1000
AI_RETRY_MAX_DELAY_MS=16000
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS_LIGHT=4096
AI_MAX_OUTPUT_TOKENS_HEAVY=16384
EXPORTS_STORAGE_BUCKET=exports
EXPORT_DOWNLOAD_URL_TTL_SECONDS=600

PDF_OCR_ENABLED=true
PDF_OCR_LANGUAGES=eng
PDF_OCR_MAX_PAGES=2
PDF_OCR_RENDER_SCALE=2
PDF_OCR_CACHE_PATH=/tmp/cv-builder-ocr-cache

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# New checkoutable subscription plans.
STRIPE_WEEKLY_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
# Legacy plans retained for existing subscribers/webhooks.
STRIPE_PRO_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=
BILLING_TRIAL_PERIOD_DAYS=3
BILLING_CHECKOUT_SUCCESS_URL=http://localhost:5173/app/pricing?checkout=success
BILLING_CHECKOUT_CANCEL_URL=http://localhost:5173/app/pricing?checkout=cancel
BILLING_PORTAL_RETURN_URL=http://localhost:5173/app/pricing
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Protects the daily expired guest-upload cleanup endpoint (set in production).
CRON_SECRET=

# Privacy release gates: keep disabled until the documented review is complete.
PRIVACY_REVIEW_APPROVED=false
PRIVACY_AI_PROVIDER_APPROVED=false
# Product policy: explicit AI permission is required for the CV experience.
PRIVACY_AI_REQUIRED=true
PRIVACY_BRAND_NAME=JobSpecificCV
PRIVACY_CONTROLLER_NAME="Alper Çamlı"
PRIVACY_CONTROLLER_COUNTRY=Canada
PRIVACY_CONTROLLER_ADDRESS=Toronto, ON, Canada
PRIVACY_CONTACT_EMAIL=camlialper03@gmail.com
PRIVACY_HOSTING_REGION=Germany
# JSON array of verified processors. Required fields per row:
# id,name,purpose,countries,retention,safeguards. Required IDs: supabase,vercel.
# Also document stripe/google-analytics and the actual AI_PROVIDER when enabled.
# See docs/privacy-processors.json for the current local provider disclosures.
# Approval flags alone do not replace this list. Restart the backend after edits.
PRIVACY_PROCESSORS_JSON='[{"id":"supabase","name":"Supabase","purpose":"Account authentication, CV database and private file storage.","countries":"Primary project hosting: Germany, as configured by the operator. Support and subprocessors may process data internationally; see the published subprocessor list.","retention":"Guest recovery expires after 24 hours; expired uploads are removed by daily cleanup. Account content remains until deletion. Backup availability and expiry depend on the project plan; database backups do not include Storage objects.","safeguards":"Private storage and authorized database access in the app. Provider publishes data-processing terms, subprocessor information and international-transfer safeguards: https://supabase.com/legal/customer-resources/data-processing-addendum"},{"id":"vercel","name":"Vercel","purpose":"Website hosting and backend request execution.","countries":"Primary backend region: Germany, as configured by the operator. Global delivery, support and subprocessors may involve other countries, including the United States.","retention":"Request/log retention depends on the service and plan. Our application omits CV content and credentials from operational logs; the operator targets 14 days for operational logs. Provider-held data follows Vercel retention policies and applicable contractual/legal obligations.","safeguards":"Provider publishes a DPA and international-transfer safeguards: https://vercel.com/legal/dpa. Application logging does not control upstream platform retention."},{"id":"openai","name":"OpenAI","purpose":"Analyze extracted CV text and generate CV guidance and editing suggestions after AI permission. Relevant career/education context may be included; referral source is excluded.","countries":"International processing, including the United States. This app uses the standard API endpoint; EU-only processing or zero-data-retention arrangements are not represented as configured.","retention":"Chat Completions API: abuse-monitoring logs may contain inputs/outputs for up to 30 days by default, with legal/safety exceptions. Model-specific prompt caches may persist for up to 24 hours. No stored Chat Completion is requested by the app.","safeguards":"API content is not used for model training by default. Provider publishes data controls and contractual safeguards: https://developers.openai.com/api/docs/guides/your-data. Withdrawal blocks future calls but cannot recall previously transmitted data."},{"id":"stripe","name":"Stripe","purpose":"Checkout, subscription billing, payment security and legally required financial records; CV content and survey answers are not sent for payment processing.","countries":"International processing, including the United States and India, as described in Stripe privacy information.","retention":"Payment and financial records may remain after account deletion for legal, tax, accounting and fraud-prevention obligations. Stripe applies the periods required by applicable obligations; no universal retention period is asserted.","safeguards":"Hosted payment interfaces and provider data-processing/transfer terms: https://stripe.com/legal/dpa and https://stripe.com/privacy."},{"id":"google-analytics","name":"Google Analytics","purpose":"Optional, consent-based usage statistics and funnel measurement. No CV content, filenames, questionnaire answers, account IDs or authentication URLs are included in app analytics payloads.","countries":"International processing through Google infrastructure; Germany-only processing is not promised.","retention":"Standard GA4 event-level retention is configurable to 2 or 14 months; the actual property setting applies. Aggregate reporting may have different retention. Our browser analytics choice lasts 180 days and can be changed at any time.","safeguards":"No Google analytics script or events before opt-in; Global Privacy Control overrides acceptance. App requests disable advertising personalization and Google Signals. Provider terms: https://business.safety.google/adsprocessorterms/. Advertising and automatic-measurement property settings must match the app policy."},{"id":"google-auth","name":"Google Sign-In","purpose":"Optional Google account authentication, sharing the sign-in identity needed to create or access the account. Separate from optional Google Analytics.","countries":"Google processes identity data internationally under its privacy policy; Germany-only processing is not promised.","retention":"Google account data is governed by Google account settings and its privacy policy. The app retains the linked account profile until deletion.","safeguards":"OAuth sign-in through Supabase. Provider identity/privacy information: https://policies.google.com/privacy."}]'
