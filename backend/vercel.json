{
  "version": 2,
  "regions": [
    "fra1"
  ],
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/pdfjs-dist/**",
          "assets/fonts/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/guest-imports/cleanup",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/v1/billing/analytics/refresh",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/v1/billing/analytics/backfill",
      "schedule": "0 4 1 1 *"
    }
  ]
}
